<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageName %> - <%= pageInfo.config.systemName %></title>

    <script src="/assets/js/jquery-3.7.1.min.js"></script>

    <script src="/assets/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/assets/style/bootstrap.min.css">

    <script type="text/javascript" src="/assets/jquery-validation/dist/jquery.validate.min.js"></script>
    <script type="text/javascript" src="/assets/jquery-validation/dist/additional-methods.min.js"></script>

    <script src="/assets/js/select2.min.js"></script>
    <link href="/assets/style/select2.min.css" rel="stylesheet" />

    <script src="/assets/js/main.js"></script>
    <link rel="stylesheet" href="/assets/style/main.css">
</head>
<body>
    <% if(typeof loginPage == 'undefined' || loginPage != true) { %>
    <header class="shadow">
        <div class="bg-success-subtle pt-4 pb-4">
            <div class="container">
                <div class="header-logo mb-3"><img src="/assets/images/HKMU__LOGO.png" alt=""><div class="fs-4"><%= pageInfo.config.systemName %></div></div>
                <% if(pageInfo.session.client != null) { %><div class="fs-5 text-center mt-4">Hello, <%= pageInfo.session.client.userName %></div><% } %>
            </div>
        </div>

        <% if(pageInfo.session.authenticated == true) { %>
        <div class="bg-body-secondary">
            <div class="container">
                <nav class="navbar navbar-expand-lg">
                    <ul class="nav justify-content-center">
                        <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/studentInfo">Student List</a></li>
                        <li class="nav-item"><a class="nav-link" href="/course/statistic">Course Statistic</a></li>
                        <li class="nav-item"><a class="nav-link text-danger" href="/logout">Logout</a></li>
                    </ul>
                </nav>
            </div>
        </div>
        <% } %>

    </header>
    <div class="container">
        <div class="spacer"></div>
        <% if(pageInfo.session.pageAlert != null && Array.isArray(pageInfo.session.pageAlert) && pageInfo.session.pageAlert.length > 0){ %>
            <% pageInfo.session.pageAlert.forEach((row) => { %>
                <div class="alert alert-<%= row.type %>"><%= row.msg %></div>
            <% }) %>
            <div class="pt-3"></div>
        <% } %>

        <h2 class="text-center"><%= pageName %></h2>

        <div class="spacer"></div>
    <% } %>