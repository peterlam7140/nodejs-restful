<%- include('header', {loginPage: true}) -%>

<div class="login-container">
    <div class="login-bg"><img src="/assets/images/hkmu_ioh.jpg" alt=""></div>
    <div class="login-panel">

        <h1 class="fs-3 mb-4 text-center"><%= pageInfo.config.systemName %></h1>

        <% if(pageInfo.session.pageAlert != null && Array.isArray(pageInfo.session.pageAlert) && pageInfo.session.pageAlert.length > 0){ %>
            <% pageInfo.session.pageAlert.forEach((row) => { %>
                <div class="alert alert-<%= row.type %>"><%= row.msg %></div>
            <% }) %>
            <div class="pt-3"></div>
        <% } %>

        <section class="card shadow-sm">
            <div class="card-body">
                <div class="login-logo mb-3 text-center"><img src="/assets/images/HKMU__LOGO.png" alt=""></div>
                <h2 class="fs-4 mb-3 text-center"><%= pageName %></h2>
                <form action="" method="post">
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">User ID</label>
                            <input class="form-control" type="text" name="userId">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Password</label>
                            <input class="form-control" type="password" name="userPwd">
                        </div>
                    </div>
                    <div class="row mb-3 pt-3">
                        <div class="col">
                            <input class="btn btn-primary w-100" type="submit" value="Login">
                        </div>
                    </div>
                </form>
            </div>
        </section>

    </div>
</div>

<%- include('footer', {loginPage: true}) -%>