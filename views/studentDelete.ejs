<%- include('header', {pageName: pageName}) -%>

<form action="/studentInfo/delete/<%= formData.studId %>" method="post">
    <section class="card shadow">
        <div class="card-body bg-warning-subtle">
            <div class="text-center">
                <h4>Did you want to delete this record?</h4>
                <h2><%= formData.studName %></h2>
            </div>

            <div class="spacer"></div>

            <div class="text-center">
                <input class="btn btn-danger" type="submit" value="Yes">
                <a class="btn btn-secondary" href="/studentInfo/view/<%= formData.studId %>">No</a>
            </div>
        </div>
    </section>

</form>

<%- include('footer') -%>